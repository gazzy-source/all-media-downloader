# =============================================================================
# All-Media Downloader Bot — environment template
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# Required — from @BotFather
BOT_TOKEN=

# Optional: comma-separated Telegram user IDs (bypass rate limits)
ADMIN_IDS=

# Concurrency & limits (5 parallel jobs OK on ~1GB VPS with MemoryMax ~700M)
MAX_CONCURRENT_DOWNLOADS=5
MAX_FILE_SIZE_MB=49
RATE_LIMIT_PER_HOUR=40

# Paths (relative to project root or absolute)
DOWNLOAD_DIR=downloads
TEMP_DIR=temp

# Optional: Netscape cookies for age-restricted / private public-ish content
# COOKIES_FILE=cookies.txt

# YouTube PO-token provider (bgutil). Public videos download WITHOUT cookies
# when this server is reachable. Empty = default http://127.0.0.1:4416.
# Run it via: docker compose up -d bgutil-provider
# (docker-compose.yml already sets POT_PROVIDER_URL for the bot container)
# POT_PROVIDER_URL=http://127.0.0.1:4416

# Channels: post the downloaded media, then delete the original link post
# (default 1), so nobody has to remove it by hand. Needs the "Delete
# messages" admin right; without it the media is posted and the link stays.
# CHANNEL_REPLACE_LINK=1

# Give up reading a link after this many seconds (default 45). Stops a
# flaky connection from leaving a user staring at 'Analyzing...' for minutes.
# EXTRACT_TIMEOUT=45

# Optional: proxy (http://host:port or socks5://user:pass@host:port)
# PROXY=
#
# Some platforms block datacenter/VPS IP ranges outright (YouTube answers every
# player client with "Sign in to confirm you're not a bot", Reddit asks for
# account auth, Bilibili returns HTTP 412). A residential/mobile proxy is the
# reliable fix. Residential proxies bill per GB and video is heavy, so route
# ONLY the blocked platforms through it and let the rest go out directly:
# Cloudflare WARP in proxy mode is a free way to get one (see README):
#   sudo warp-cli --accept-tos mode proxy && sudo warp-cli --accept-tos connect
# PROXY=socks5://127.0.0.1:40000
# PROXY_HOSTS=youtube.com,youtu.be,music.youtube.com,reddit.com,redd.it,soundcloud.com
# Leave PROXY_HOSTS empty to send everything through the proxy.
# PROXY_HOSTS=
#
# IMPORTANT, when PROXY points at 127.0.0.1 and YouTube is proxied: the bgutil
# PO-token provider must be able to reach that same address. The yt-dlp plugin
# forwards this PROXY value to the provider so the token is minted from the
# same egress IP. A provider in a bridge-network container resolves 127.0.0.1
# to ITSELF, so every mint fails with ECONNREFUSED while /ping still answers
# 200 — and YouTube answers "Sign in to confirm you're not a bot" with nothing
# in the logs to explain it. Run the provider with host networking:
#   docker run -d --name bgutil-provider --restart unless-stopped --network host #     brainicism/bgutil-ytdlp-pot-provider:latest --host 127.0.0.1
# The bot verifies this at startup and logs "CANNOT MINT" if it is wrong.

# Optional: folder containing ffmpeg / ffmpeg.exe (auto-detected on many systems)
# FFMPEG_LOCATION=

# Netscape cookies (fixes YouTube "confirm you're not a bot" on VPS IPs)
# COOKIES_FILE=cookies.txt

# Group behaviour: paste link → instant download (no wizard). 1=on
AUTO_DOWNLOAD_GROUPS=1
# Instant download in private chats too
AUTO_DOWNLOAD_ALWAYS=0
# Auto quality: 480 | 720 | 1080 | max  (default 1080 caps 4K sources)
AUTO_QUALITY=1080

# Local Bot API for larger uploads (optional). Default Telegram limit ~50MB.
# TELEGRAM_API_URL=http://127.0.0.1:8081/bot
# MAX_FILE_SIZE_MB=1900

# Optional profile overrides via Bot API (leave empty to keep @BotFather settings)
# BOT_NAME=All-Media Downloader Bot
# BOT_DESCRIPTION=Download videos, audio, and images from any platform instantly. Built by Gazzy Labs.
# BOT_SHORT_DESCRIPTION=Download videos, audio & images from any platform. Gazzy Labs.
