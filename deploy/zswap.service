[Unit]
Description=Enable zswap (compressed RAM cache for swap; slow boot volume)
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo lz4 > /sys/module/zswap/parameters/compressor; echo 20 > /sys/module/zswap/parameters/max_pool_percent; echo Y > /sys/module/zswap/parameters/enabled'
ExecStop=/bin/sh -c 'echo N > /sys/module/zswap/parameters/enabled'

[Install]
WantedBy=multi-user.target
